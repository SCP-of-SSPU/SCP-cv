<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ScpCv.Contracts\ScpCv.Contracts.csproj" />
    <ProjectReference Include="..\..\src\ScpCv.Domain\ScpCv.Domain.csproj" />
    <ProjectReference Include="..\..\src\ScpCv.ControlHost\ScpCv.ControlHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\docs\components\schemas\**\*.yaml"
          Link="OpenApiSchemas\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\specs\003-dotnet-runtime-refactor\contracts\runtime-ipc.md"
          Link="Contracts\runtime-ipc.md"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\docs\openapi.yaml"
          Link="OpenApi\openapi.yaml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\docs\paths\*.yaml"
          Link="OpenApi\paths\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
