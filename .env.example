# Django 基础配置
DJANGO_SECRET_KEY=please-change-me-for-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_LANGUAGE_CODE=zh-hans
DJANGO_TIME_ZONE=Asia/Shanghai

# gRPC 服务配置
GRPC_HOST=127.0.0.1
GRPC_PORT=50051

# 第三方可执行文件（留空则自动从 PATH 检测）
MEDIAMTX_BIN_PATH=
MEDIAMTX_API_BASE=http://127.0.0.1:9997
MEDIAMTX_SRT_PORT=8890
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_SRT_PUBLIC_HOST=
MEDIAMTX_SRT_READ_HOST=
MEDIAMTX_SRT_READ_LATENCY_MS=50
MEDIAMTX_SRT_PUBLISH_LATENCY_US=30000
MEDIAMTX_RTSP_READ_TRANSPORT=tcp

# 直播低延迟与预热配置
STREAM_VLC_NETWORK_CACHING_MS=50
STREAM_VLC_LIVE_CACHING_MS=50
STREAM_VLC_FILE_CACHING_MS=0
STREAM_VLC_CLOCK_JITTER=0
STREAM_VLC_CLOCK_SYNCHRO=0
STREAM_VLC_DROP_LATE_FRAMES=True
STREAM_VLC_SKIP_FRAMES=True
STREAM_PREHEAT_NETWORK_CACHING_MS=100
STREAM_PREHEAT_LIVE_CACHING_MS=100
STREAM_PREHEAT_TTL_SECONDS=60

# LibreOffice 启动配置：PPT 播放器由导入媒体源或显控页临时选择，不再通过系统配置选择
LIBREOFFICE_BIN_PATH=
LIBREOFFICE_CONNECT_TIMEOUT_SECONDS=10
LIBREOFFICE_BRIDGE_COMMAND_TIMEOUT_SECONDS=120
PPT_PREVIEW_WORKER_TIMEOUT_SECONDS=180
PPT_PLAYBACK_EXPORT_TIMEOUT_SECONDS=180

# Vite 前端开发服务端口与直连 Django 后端地址
VITE_FRONTEND_PORT=5173
VITE_BACKEND_TARGET=http://127.0.0.1:8000
